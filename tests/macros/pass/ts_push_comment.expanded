fn collect ( parts : & [ & str ] ) -> ( Vec < String > , i32 , i32 ) { let mut comments : Vec <
String > = Vec :: new ( ) ; let mut margin : i32 = - 1 ; let mut indent : i32 = 0 ; for p in parts {
{ let text : String = ( * p ) . to_string ( ) ; if margin == - 1 { margin = indent ; } indent +=
text . len ( ) as i32 ; comments . push ( text ) ; } ; } { let text : String = ( format ! ( "n={0}"
, 3 ) ) . to_string ( ) ; if margin == - 1 { margin = indent ; } indent += text . len ( ) as i32 ;
comments . push ( text ) ; } ; ( comments , margin , indent ) } fn main ( ) { let ( c , margin ,
indent ) = collect ( & [ "ab" , "cde" ] ) ; println ! ( "comments={0:?} margin={1} indent={2}" , c ,
margin , indent ) ; }
