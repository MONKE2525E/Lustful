to_string ( & "a.ts" ) , :: std :: string :: ToString :: to_string ( & 2 ) ] ) ) ) ; } ; if let Some
( tracer ) = & state . tracer { tracer . borrow_mut ( ) . write ( "done" , :: alloc :: vec :: Vec ::
new ( ) ) ; } ; let quiet = State { tracer : None } ; if let Some ( tracer ) = & quiet . tracer {
