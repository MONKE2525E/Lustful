# ! [ feature ( prelude_import ) ] extern crate std ; # [ prelude_import ] use std :: prelude ::
rust_2024 :: * ; use std :: sync :: OnceLock ; pub struct LocaleMessages { pub text : String , } pub
fn load_locale_data ( data : & [ u8 ] ) -> LocaleMessages { LocaleMessages { text : String ::
from_utf8_lossy ( data ) . trim ( ) . to_string ( ) } } macro_rules ! locale_data { ( $ data : ident
, $ func : ident , $ file : literal ) => { static $ data : & [ u8 ] = include_bytes ! ( concat ! (
"../data/loc/" , $ file ) ) ; fn $ func ( ) -> & 'static LocaleMessages { static MESSAGES : OnceLock
< LocaleMessages > = OnceLock :: new ( ) ; MESSAGES . get_or_init ( || load_locale_data ( $ data ) )
} } ; } static EN_DATA : & [ u8 ] = b"hello locale\n" ; fn en ( ) -> & 'static LocaleMessages {
static MESSAGES : OnceLock < LocaleMessages > = OnceLock :: new ( ) ; MESSAGES . get_or_init ( ||
load_locale_data ( EN_DATA ) ) } fn main ( ) { { :: std :: io :: _print ( format_args ! (
"locale=\'{0}\' bytes={1} same={2}\n" , en ( ) . text , EN_DATA . len ( ) , std :: ptr :: eq ( en (
) , en ( ) ) ) ) ; } ; }
