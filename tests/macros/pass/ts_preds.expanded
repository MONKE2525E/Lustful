) * ) ) ? ) ) , * ] } ; } fn main ( ) { let ps : Vec < ContextPredicate > = :: alloc :: boxed ::
box_assume_init_into_vec_unsafe ( :: alloc :: intrinsics :: write_box_via_move ( :: alloc :: boxed
:: Box :: new_uninit ( ) , [ Arc :: new ( is_positive ) as ContextPredicate , at_least ( 3 ) , Arc
:: new ( is_even ) as ContextPredicate ] ) ) ; let mut ctx = Ctx { value : 4 } ; let r : Vec < bool
