gostd :: debug :: assert_failed ( Some ( format_args ! ( $ ( $ arg ) + ) ) ) } } ; } fn panic_text (
f : impl FnOnce ( ) + std :: panic :: UnwindSafe ) -> String { std :: panic :: set_hook ( Box :: new
( | _ | { } ) ) ; match std :: panic :: catch_unwind ( f ) { Ok ( ( ) ) => "no panic" . to_string (
) , Err ( e ) => { if let Some ( s ) = e . downcast_ref :: < String > ( ) { s . clone ( ) } else if
let Some ( s ) = e . downcast_ref :: < & str > ( ) { s . to_string ( ) } else { "unknown" .
to_string ( ) } } } } fn main ( ) { if ! ( 1 + 1 == 2 ) { crate :: gostd :: debug :: assert_failed (
None ) } ; if ! true { crate :: gostd :: debug :: assert_failed ( Some ( format_args ! (
