:: std :: io :: _print ( format_args ! ( "assert-false: {0}\n" , panic_text ( || if ! ( 1 == 2 ) {
crate :: gostd :: debug :: assert_failed ( Some ( format_args ! ( "one is not {0}" , 2 ) ) ) } ) ) )
; } ; { :: std :: io :: _print ( format_args ! ( "unported: {0}\n" , panic_text ( || { { crate ::
core :: record_unported ( "checker.go:Foo" ) ; { :: core :: panicking :: panic_fmt ( format_args ! (
"unported Go code: {0}" , "checker.go:Foo" ) ) ; } } ; } ) ) ) ; } ; }
