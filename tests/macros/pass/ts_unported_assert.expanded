# ! [ feature ( prelude_import ) ] extern crate std ; # [ prelude_import ] use std :: prelude ::
rust_2024 :: * ; pub mod core { pub fn record_unported ( name : & str ) { { :: std :: io :: _print (
format_args ! ( "recorded:{0}\n" , name ) ) ; } ; } } pub mod gostd { pub mod debug { pub fn
assert_failed ( msg : Option < std :: fmt :: Arguments < '_ >> ) -> ! { match msg { Some ( m ) => {
:: core :: panicking :: panic_fmt ( format_args ! ( "assertion failed: {0}" , m ) ) ; } None => { ::
